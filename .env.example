# Copy to .env and fill in. Every value here is read by config.php.

# ---- Site identity -----------------------------------------------------------
SITE_URL=https://example.com                 # public base URL of the site, no trailing slash
SITE_NAME=Example Motors                     # showroom name the AI introduces itself with
BUSINESS_TAGLINE=a luxury and exotic car showroom in Dubai, UAE   # one-line description used in the AI's system prompt
CURRENCY=AED                                 # currency code shown in every price (e.g. AED, USD, EUR)
DEFAULT_DIAL_CODE=+971                       # pre-selected country code in phone inputs
CONTACT_ADDRESS=Showroom 1, Example Street, City   # showroom address the AI gives customers
CONTACT_PHONE=+971 50 000 0000               # public phone / WhatsApp number (display format)
CONTACT_EMAIL=info@example.com               # public email the AI gives customers
CONTACT_WHATSAPP=971500000000                # WhatsApp number digits-only, for wa.me links

# ---- Database ------------------------------------------------------------------
DB_HOST=localhost                            # MySQL host
DB_NAME=                                     # database name (same DB as the site's cars table)
DB_USER=                                     # database user
DB_PASS=                                     # database password

# ---- Chatbot / AI -----------------------------------------------------------------
CHATBOT_ENABLED=true                         # false hides the widget and disables both bots
ANTHROPIC_API_KEY=                           # from https://console.anthropic.com -> API Keys (server-side only)
CHATBOT_MODEL=claude-haiku-4-5               # model for normal chat turns (fast + cheap)
CHATBOT_VISION_MODEL=claude-sonnet-5         # stronger model used only when a customer sends a photo
CHATBOT_MAX_TOKENS=1024                      # max length of one bot reply
CHATBOT_RATE_LIMIT=30                        # max visitor messages per IP/customer per hour
CHATBOT_HISTORY_LIMIT=24                     # messages of context sent to the AI per turn
CHATBOT_LEAD_EMAIL=                          # email that gets a ping for every HOT lead (empty = off)

# ---- WhatsApp Cloud API (Meta) -------------------------------------------------------
WA_CLOUD_TOKEN=                              # permanent System User access token (Meta Business settings)
WA_CLOUD_PHONE_ID=                           # "Phone number ID" from WhatsApp > API Setup (NOT the phone number)
WA_WEBHOOK_VERIFY_TOKEN=                     # any long random string; must match what you enter in Meta's webhook config
WA_APP_SECRET=                               # Meta app secret; enables webhook signature verification (recommended)
WA_CLOUD_TO=                                 # digits-only number that receives Cloud-API lead alerts (cloudapi notifier only)
WA_CLOUD_TEMPLATE=new_lead_alert             # approved Utility template name for those alerts

# ---- CallMeBot notifications (simple free alternative to the Cloud API notifier) ----
WA_NOTIFY_PHONE=                             # digits-only number that receives lead alerts (empty = off)
WA_NOTIFY_APIKEY=                            # personal key CallMeBot sends you (see includes/chatbot-notify.php)
